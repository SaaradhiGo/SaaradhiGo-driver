<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location. FINE is required for dispatch: matching a driver to a
         pickup at COARSE accuracy (~1-2km) is not usable. BACKGROUND keeps
         the location stream alive when the screen is off, which is the normal
         state of a phone in a dashboard mount. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Foreground service with the `location` type: mandatory from Android
         14 for background location, and on Xiaomi / Vivo / Oppo / Realme
         builds it is what stops the OS killing the app mid-shift. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Android 13+ requires a runtime grant before any notification shows,
         including the ride-offer heads-up banner. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Survive a reboot mid-shift without the driver having to notice. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Optional. Requested with a rationale screen, never silently: some
         OEM firmwares aggressively doze the app and stop dispatch. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- GPS is a hard requirement for a driver device, but declared
         non-required so the Play listing is not filtered unnecessarily. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <application
        android:label="SaaradhiGo Drive"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Google Maps SDK key.
             This is an ANDROID key and is a different credential from the
             server-side Maps key used by the backend proxy. It must be
             restricted in Google Cloud Console to this package name plus the
             release signing SHA-1, which is what makes shipping it in the
             APK acceptable. Injected at build time via a Gradle property
             (see android/app/build.gradle.kts), so it is never committed.

             CAUTION: a double hyphen is illegal inside an XML comment. This
             block used to spell out an example flutter build command that
             contained one, which made the whole manifest unparseable. Every
             APK build failed with ManifestMerger2 "Error parsing
             AndroidManifest.xml", and nothing else caught it because
             flutter test and flutter analyze never read this file. Keep
             example command lines out of here. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Tapping an FCM ride-offer notification opens the app rather than
             doing nothing. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ride_requests"/>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Handing navigation to the OS maps app requires visibility of an
             app that can service a geo/https directions intent. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
